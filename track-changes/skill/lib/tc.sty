% tc.sty — track-changes LaTeX support
%
% Provides the \tc{} and \tcn{} macros used by the track-changes skill
% to wrap AI-introduced edits in a yellow highlight with a reference
% number sitting outside the highlight.
%
% Usage in a .tex preamble:
%   \usepackage{tc}
%
% Then in the body:
%   tes\tc{ted}\tcn{7}                       % insertion
%   tes\tc{\sout{ted}}\tcn{8}                % deletion
%   \tc{\sout{slow}tired}\tcn{9}             % replacement
%
% Loads `soul` for \hl (highlight) and \sout (strikeout). If `soul` is
% incompatible with your setup (hyperref, fontspec with non-TeX-Gyre
% fonts under XeLaTeX/LuaLaTeX, or another highlight package), define
% the fallback inline in your preamble after omitting this package:
%
%   \usepackage{xcolor,ulem}
%   \newcommand{\tc}[1]{\colorbox{yellow}{#1}}
%   \newcommand{\tcn}[1]{\textsuperscript{#1}}
%
% See reference/highlight-syntax.md and SKILL.md §10 for details.

% v6 additions:
%   - Optional provenance on \tc:   \tc[imported]{...}\tcn{N}  (default authored)
%   - Whole-region insertion (Fix D): a colored left CHANGE-BAR spanning a
%     multi-block new region — robust across paragraph breaks, display math, and
%     verbatim (where soul \hl fails):
%       \begin{tcregion}{N}[imported]
%         \section{New}  ...multiple blocks...
%       \end{tcregion}
%     The bar color encodes provenance (authored vs imported); N is printed at
%     the region start.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tc}[2026/06/09 v6.0 track-changes highlight + region macros]

\RequirePackage{soul}
\RequirePackage{xcolor}
\RequirePackage{ifthen}
\RequirePackage{framed}   % \MakeFramed left-bar — robust over page/para breaks

% Provenance palette.
\definecolor{tchighlight}{rgb}{1,1,0}            % authored inline highlight (yellow)
\definecolor{tchighlightimported}{rgb}{0.7,1,1}  % imported inline highlight (pale cyan)
\definecolor{tcbarauthored}{rgb}{0.85,0.55,0.08} % authored region bar (amber)
\definecolor{tcbarimported}{rgb}{0.12,0.46,0.78} % imported region bar (blue)
\sethlcolor{tchighlight}

% \tc[<prov>]{<content>} — wrap inline content in a highlight. Optional prov in
% {authored, imported} (default authored) tints the highlight; imported uses the
% pale-cyan color so the reviewer can tell a verbatim import from authored text.
\newcommand{\tc}[2][authored]{%
  \ifthenelse{\equal{#1}{imported}}%
    {{\sethlcolor{tchighlightimported}\hl{#2}}}%
    {\hl{#2}}}

% \tcn{<N>} — render the reference number as a superscript outside the
% highlight. Single integer argument; the package does not enforce that
% it is numeric (the PreToolUse hook does).
\newcommand{\tcn}[1]{\textsuperscript{#1}}

% \begin{tcregion}{<N>}[<prov>] ... \end{tcregion} — a whole-region insertion
% marked by a colored left change-bar (NOT a background highlight, which soul
% cannot span across math/verbatim/paragraphs). N is printed at the region
% start; prov in {authored, imported} (default authored) picks the bar color.
% Arg spec `m o` (xparse, in the LaTeX kernel) gives the {N}[prov] order the
% PreToolUse grammar expects.
\NewDocumentEnvironment{tcregion}{m o}{%
  \def\tc@barcolor{tcbarauthored}%
  \IfValueT{#2}{\ifthenelse{\equal{#2}{imported}}{\def\tc@barcolor{tcbarimported}}{}}%
  \def\FrameCommand{{\color{\tc@barcolor}\vrule width 3pt}\hspace{8pt}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
  {\footnotesize\textbf{\textcolor{\tc@barcolor}{[\,#1\,]}}\quad}\ignorespaces
}{%
  \par\endMakeFramed
}

\endinput
