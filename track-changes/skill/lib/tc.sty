% tc.sty — track-changes LaTeX support
%
% Provides the \tc{} and \tcn{} macros used by the track-changes skill
% to wrap AI-introduced edits in a yellow highlight with a reference
% number sitting outside the highlight.
%
% Usage in a .tex preamble:
%   \usepackage{tc}
%
% Then in the body:
%   tes\tc{ted}\tcn{7}                       % insertion
%   tes\tc{\sout{ted}}\tcn{8}                % deletion
%   \tc{\sout{slow}tired}\tcn{9}             % replacement
%
% Loads `soul` for \hl (highlight) and \sout (strikeout). If `soul` is
% incompatible with your setup (hyperref, fontspec with non-TeX-Gyre
% fonts under XeLaTeX/LuaLaTeX, or another highlight package), define
% the fallback inline in your preamble after omitting this package:
%
%   \usepackage{xcolor,ulem}
%   \newcommand{\tc}[1]{\colorbox{yellow}{#1}}
%   \newcommand{\tcn}[1]{\textsuperscript{#1}}
%
% See reference/highlight-syntax.md and SKILL.md §10 for details.

% v6 additions:
%   - Optional provenance on \tc:   \tc[imported]{...}\tcn{N}  (default authored)
%   - Whole-region insertion (Fix D): a colored left CHANGE-BAR spanning a
%     multi-block new region — robust across paragraph breaks, display math, and
%     verbatim (where soul \hl fails):
%       \begin{tcregion}{N}[imported]
%         \section{New}  ...multiple blocks...
%       \end{tcregion}
%     The bar color encodes provenance (authored vs imported); N is printed at
%     the region start.
%
% v9 additions (source-validation discipline):
%   - tcregion arg spec extended to {m o o}: a SECOND optional carries a source
%     locator for the source-grounded provenances —
%       \begin{tcregion}{N}[sourced][@daskin2013 p.114] ... \end{tcregion}
%     When present it prints "sourced: <src>" in the bar color after the [N] head.
%   - Two new region-bar colors in the GREEN family, shared by the two
%     source-grounded provenances: transcript and sourced both use tcbarsourced
%     (AI wording grounded in a source the reader can open). Four-color ceiling
%     preserved (yellow inline marks + amber/blue/green regions).
%   - tcverbatim environment: a GRAY-barred scaffolding block holding a verbatim
%     source excerpt for side-by-side confirmation, self-labeled to signal it is
%     temporary (delete after confirming). No number; not a tracked region:
%       \begin{tcverbatim}{Freight Transport.docx p. 12}
%         <verbatim excerpt>
%       \end{tcverbatim}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tc}[2026/07/12 v9.0 track-changes highlight + region + verbatim macros]

\RequirePackage{soul}
\RequirePackage{xcolor}
\RequirePackage{ifthen}
\RequirePackage{framed}   % \MakeFramed left-bar — robust over page/para breaks

% Provenance palette.
\definecolor{tchighlight}{rgb}{1,1,0}            % authored inline highlight (yellow)
\definecolor{tchighlightimported}{rgb}{0.7,1,1}  % imported inline highlight (pale cyan)
\definecolor{tcbarauthored}{rgb}{0.85,0.55,0.08} % authored region bar (amber)
\definecolor{tcbarimported}{rgb}{0.12,0.46,0.78} % imported region bar (blue)
\definecolor{tcbarsourced}{rgb}{0.18,0.55,0.34}  % transcript+sourced region bar (green)
\definecolor{tcgray}{rgb}{0.6,0.6,0.6}           % tcverbatim scaffolding bar (gray)
\sethlcolor{tchighlight}

% \tc[<prov>]{<content>} — wrap inline content in a highlight. Optional prov in
% {authored, imported} (default authored) tints the highlight; imported uses the
% pale-cyan color so the reviewer can tell a verbatim import from authored text.
\newcommand{\tc}[2][authored]{%
  \ifthenelse{\equal{#1}{imported}}%
    {{\sethlcolor{tchighlightimported}\hl{#2}}}%
    {\hl{#2}}}

% \tcn{<N>} — render the reference number as a superscript outside the
% highlight. Single integer argument; the package does not enforce that
% it is numeric (the PreToolUse hook does).
\newcommand{\tcn}[1]{\textsuperscript{#1}}

% \begin{tcregion}{<N>}[<prov>][<src>] ... \end{tcregion} — a whole-region
% insertion marked by a colored left change-bar (NOT a background highlight,
% which soul cannot span across math/verbatim/paragraphs). N is printed at the
% region start; prov in {authored, imported, transcript, sourced} (default
% authored) picks the bar color — transcript and sourced share the green
% tcbarsourced. The optional second bracket <src> is a source locator; when
% present it is printed after the [N] head as "sourced: <src>" in the bar color
% (meaningful with sourced/transcript, but rendered whenever supplied). Arg spec
% `m o o o` (xparse, in the LaTeX kernel) gives the {N}[prov][src][join] order the
% PreToolUse grammar expects. The 4th optional <join> (9.4.0; prev|next) is a
% resolve-time paragraph-join directive consumed by `/tc accept`; it has NO visual
% and is accepted-and-ignored here so the .tex compiles whether or not it is set.
\NewDocumentEnvironment{tcregion}{m o o o}{%
  \def\tc@barcolor{tcbarauthored}%
  \IfValueT{#2}{%
    \ifthenelse{\equal{#2}{imported}}{\def\tc@barcolor{tcbarimported}}{}%
    \ifthenelse{\equal{#2}{transcript}}{\def\tc@barcolor{tcbarsourced}}{}%
    \ifthenelse{\equal{#2}{sourced}}{\def\tc@barcolor{tcbarsourced}}{}%
  }%
  \def\FrameCommand{{\color{\tc@barcolor}\vrule width 3pt}\hspace{8pt}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
  {\footnotesize\textbf{\textcolor{\tc@barcolor}{[\,#1\,]}}\quad}%
  \IfValueT{#3}{{\footnotesize\textcolor{\tc@barcolor}{sourced: #3}}\quad}%
  \ignorespaces
}{%
  \par\endMakeFramed
}

% \begin{tcverbatim}{<citation>} ... \end{tcverbatim} — a GRAY-barred
% scaffolding block holding a verbatim source excerpt for side-by-side
% confirmation. Not a tracked region and not numbered: it is temporary text the
% author deletes once the source-grounded refinement beside it is confirmed. The
% gray left bar + \footnotesize gray body + self-label ("<citation> — delete
% after confirming") signal that intent. framed-based, so it tolerates paragraph
% breaks and display math inside.
\NewDocumentEnvironment{tcverbatim}{m}{%
  \def\FrameCommand{{\color{tcgray}\vrule width 3pt}\hspace{8pt}}%
  \MakeFramed{\advance\hsize-\width\FrameRestore}%
  \footnotesize\color{gray!80!black}%
  {\textcolor{tcgray}{#1 --- delete after confirming}\par}\ignorespaces
}{%
  \par\endMakeFramed
}

% \tcsrckey{<sentence>} (v9.1.1) — mark the load-bearing sentence (the part
% actually proposed as the source) inside a contextual tcverbatim block.
% Emphasis only (bold + underline), no color, so it stands out within the gray
% context without adding to the color count. Requires \ul from soul (loaded).
\newcommand{\tcsrckey}[1]{\textbf{\ul{#1}}}

\endinput
